algoritmo "Criar uma Matriz Identidade de 3° Ordem"
var
  m: vetor[1..3, 1..3] de Inteiro
  i, j: Inteiro
inicio
  Para i <- 1 ate 3 faca
    Para j <- 1 ate 3 faca
      Se (i = j) entao
        m[i,j] <- 1
      senao
        m[i,j] <- 0
      FimSe
    FimPara
  FimPara
  Para i <- 1 ate 3 faca
    Para j <- 1 ate 3 faca
      Escreva (m[i,j]:3)
    FimPara
    EscrevaL()
  FimPara  
fimalgoritmo